ENVIRONMENT=development
JWT_SECRET=replace-with-local-random-secret
BREVO_API_KEY=replace-with-brevo-v3-api-key
MIDTRANS_SERVER_KEY=replace-with-midtrans-sandbox-server-key
# AI uses any OpenAI-compatible provider. Defaults to Groq when only GROQ_API_KEY is set.
GROQ_API_KEY=replace-with-groq-key
# Optional provider override (example: Vikey)
# AI_PROVIDER=vikey
# AI_BASE_URL=https://api.vikey.ai/v1
# AI_API_KEY=replace-with-provider-key
# AI_MODEL=qwen2.5-72b-instruct
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
