{
  "name": "vanaila-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ssr": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "npm run build:ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "test:security": "node --test scripts/security-regression-tests.mjs",
    "test:flows": "node scripts/test-flows.mjs"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@react-pdf/renderer": "^4.5.1",
    "@types/dompurify": "^3.0.5",
    "better-auth": "^1.6.13",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
