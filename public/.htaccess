# SPA fallback for Apache / LiteSpeed static hosting (Hostinger).
# Every route that isn't a real file or directory is served index.html so
# the React Router client-side router can take over. Without this, direct
# hits and refreshes on /login, /admin, /pricing, etc. return the host's
# own 404 before the app ever loads.
#
# This file is copied verbatim from public/ into dist/ on every `npm run
# build`, so the fix ships with each deploy — nothing to configure on the host.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite requests that map to a real file or directory
  # (assets, robots.txt, sitemap.xml, favicon, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls through to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache hashed build assets; keep index.html always fresh so new
# deploys are picked up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|avif|webp|ico|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
