# Frontend environment variables — copy to .env and fill values
# These are NOT secrets, only public values

# API backend URL
VITE_API_URL=http://localhost:8787

# Show Google/GitHub OAuth buttons on login/register.
# Only set to 'true' once GOOGLE_CLIENT_ID/GITHUB_CLIENT_ID secrets are configured
# on the Worker — otherwise the buttons error on click. Default hidden.
VITE_ENABLE_OAUTH=false

# Midtrans Snap.js config
# Set to 'production' for live Midtrans, any other value uses sandbox
VITE_MIDTRANS_ENV=sandbox
# Midtrans client key (public, starts with SB-Mid-client for sandbox, Mid-client for production)
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxx

# Optional — Sentry DSN for frontend error tracking
# VITE_SENTRY_DSN=
